SEARCHCRAFT_HOST=127.0.0.1
SEARCHCRAFT_PORT=3000
SEARCHCRAFT_DATA_DIR=./data
# SEARCHCRAFT_DB_PATH=./data/searchcraft.sqlite
SEARCHCRAFT_MAX_BODY_BYTES=1048576
SEARCHCRAFT_MAX_QUERY_LENGTH=1000
SEARCHCRAFT_MAX_BULK_BATCH_SIZE=1000
# Number of immutable segments that schedules a background merge.
SEARCHCRAFT_SEGMENT_COMPACTION_THRESHOLD=8
SEARCHCRAFT_MAX_PENDING_JOBS=10000
SEARCHCRAFT_WORKER_POLL_INTERVAL_MS=50
SEARCHCRAFT_JOB_LEASE_MS=30000
SEARCHCRAFT_MAX_JOB_ATTEMPTS=5
SEARCHCRAFT_MAX_JOB_HISTORY=10000
SEARCHCRAFT_LOG_LEVEL=info
